# API / database
DATABASE_URL=postgresql://user:password@host:5432/autoblog
REDIS_URL=redis://host:6379
PORT=3001
NODE_ENV=production
WEB_URL=https://your-frontend.vercel.app

# Security
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-64-hex-characters

# AI
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=qwen/qwen3.8-27b

# Integrations
N8N_URL=https://your-n8n-host
N8N_API_KEY=replace-with-your-n8n-key
WEBHOOK_SECRET=replace-with-a-random-secret
